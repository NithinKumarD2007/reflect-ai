generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  notes     Note[]
  createdAt DateTime @default(now())
}

model Note {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String?
  rawContent      String?
  enhancedContent String?
  finalContent    String
  inputMethod     String
  tags            String?
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
